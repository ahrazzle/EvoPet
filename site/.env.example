# EvoPet site — environment
#
# Copy to .env.local for local runs. Nothing here is a secret: the library
# service's public index needs no credentials, and this site holds no key. The
# build injects the library endpoint into the bundle as a public constant.
# Never commit a filled-in .env.local.

# --- the library service ---------------------------------------------------
# Base URL of the EvoPet library service. The library page reads
# `GET {EVOPET_LIBRARY_API}/api/manifest` from it in the browser.
#
# This is a separate value from the site's own origin below, even though it
# defaults to the same decided host. The service is not deployed yet, so with
# this default the library page reports that it cannot reach the library rather
# than pretending the library is empty. Point it at wherever the service
# actually runs before any publish is claimed.
EVOPET_LIBRARY_API=https://evopet.askaconsult.com

# Development only. Set to 1 to make the library page fetch same-origin
# `/api/manifest` and let the dev server proxy it to EVOPET_LIBRARY_API above.
# Without it the page calls the absolute URL directly.
EVOPET_LIBRARY_LOCAL_PROXY=0

# --- site identity ---------------------------------------------------------
# Canonical origin, used for the absolute canonical and og:url links in the
# built pages. The site is served by GitHub Pages at www.evopet.askaconsult.com.
EVOPET_SITE_URL=https://www.evopet.askaconsult.com
